// Icon resource 1 is also what the backend's window class loads at run time (User32.registerClass).
1 ICON "app.ico"

1 VERSIONINFO
FILEVERSION     0,0,0,0
PRODUCTVERSION  0,0,0,0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription",  "webview-jvm example"
            VALUE "ProductName",      "webview-jvm"
            VALUE "FileVersion",      "0.0.0"
            VALUE "ProductVersion",   "0.0.0"
            VALUE "OriginalFilename", "webview-jvm-example.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
